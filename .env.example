# --- Core (NAS / local default) ---
DATABASE_URL="file:./data/travel.db"
DEEPSEEK_API_KEY="sk-your-deepseek-api-key"
OPENAI_BASE_URL="https://api.deepseek.com/v1"
OPENAI_MODEL="deepseek-chat"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Same Mapbox token as DogTrainer (pk.…). Required for the Lugares map.
NEXT_PUBLIC_MAPBOX_TOKEN=""
# HTTPS via Tailscale Serve (required for mobile GPS). Example:
# NEXT_PUBLIC_HTTPS_APP_URL="https://syno-nas.tailf9872a.ts.net"
NEXT_PUBLIC_HTTPS_APP_URL=""

# --- Dual-host / Vercel cloud ---
# fs (default) = public/uploads on disk (Synology Docker)
# blob = Vercel Blob (token auto-injected on Vercel, or set locally)
STORAGE_DRIVER="fs"
# BLOB_READ_WRITE_TOKEN=""

# PDF via WeasyPrint: auto-disabled on Vercel unless set to 1
# PDF_EXPORT_ENABLED="0"

# Neon Postgres (cloud only). Keep SQLite on NAS.
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
# Push cloud schema: npm run db:push:cloud
