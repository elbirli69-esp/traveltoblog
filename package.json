{
  "name": "traveltoblog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && npm run sync:export-assets && next build",
    "sync:export-assets": "mkdir -p public/export-assets/leaflet/images && cp node_modules/leaflet/dist/leaflet.css node_modules/leaflet/dist/leaflet.js public/export-assets/leaflet/ && cp node_modules/leaflet/dist/images/* public/export-assets/leaflet/images/",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate-place-notes": "prisma db push && npx --yes tsx scripts/migrate-place-comments.ts",
    "db:migrate-highlight-default": "npx --yes tsx scripts/migrate-highlight-score-default.ts",
    "test:highlight-score": "npx --yes tsx scripts/test-highlight-score.mjs",
    "db:studio": "prisma studio",
    "test:timeline": "npx --yes tsx scripts/test-timeline.mjs",
    "test:project-backup": "npx --yes tsx scripts/test-project-backup.mjs",
    "test:ai-suggest-photo-note": "npx --yes tsx scripts/test-ai-suggest-photo-note.mjs",
    "test:ai-suggest-place-note": "npx --yes tsx scripts/test-ai-suggest-place-note.mjs",
    "test:ai-suggest-day-summary": "npx --yes tsx scripts/test-ai-suggest-day-summary.mjs",
    "test:ai-suggest-reel-storyboard": "npx --yes tsx scripts/test-ai-suggest-reel-storyboard.mjs",
    "test:ai-blog-voice": "npx --yes tsx scripts/test-ai-blog-voice.mjs",
    "test:blog-completeness": "npx --yes tsx scripts/test-blog-completeness.mjs",
    "test:blog-seed-prompts": "npx --yes tsx scripts/test-blog-seed-prompts.mjs",
    "test:blog-reader-guide": "npx --yes tsx scripts/test-blog-reader-guide.mjs",
    "test:destination-fiche": "npx --yes tsx scripts/test-destination-fiche.mjs",
    "build:android": "bash scripts/build-android-apk.sh",
    "cap:sync": "npx cap sync android",
    "deploy:synology": "bash scripts/deploy-synology.sh"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/app": "^6.0.3",
    "@capacitor/cli": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "@prisma/client": "^6.5.0",
    "exifr": "^7.1.3",
    "heic-convert": "^2.1.0",
    "heic2any": "^0.0.4",
    "idb": "^8.0.2",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "mapbox-gl": "^3.29.0",
    "marked": "^18.0.11",
    "mediabunny": "^1.55.5",
    "nanoid": "^5.1.5",
    "next": "^15.2.4",
    "openai": "^4.89.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "serwist": "^9.0.12",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@serwist/next": "^9.0.12",
    "@tailwindcss/postcss": "^4.0.17",
    "@types/heic-convert": "^2.1.1",
    "@types/leaflet": "^1.9.22",
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "^22.13.14",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.2.4",
    "prisma": "^6.5.0",
    "tailwindcss": "^4.0.17",
    "typescript": "^5.8.2"
  }
}
