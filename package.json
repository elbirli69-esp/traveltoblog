{
  "name": "traveltoblog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && npm run sync:export-assets && next build",
    "sync:export-assets": "mkdir -p public/export-assets/leaflet/images && cp node_modules/leaflet/dist/leaflet.css node_modules/leaflet/dist/leaflet.js public/export-assets/leaflet/ && cp node_modules/leaflet/dist/images/* public/export-assets/leaflet/images/",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "deploy:synology": "bash scripts/deploy-synology.sh"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "exifr": "^7.1.3",
    "idb": "^8.0.2",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "marked": "^18.0.11",
    "nanoid": "^5.1.5",
    "next": "^15.2.4",
    "openai": "^4.89.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "serwist": "^9.0.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@serwist/next": "^9.0.12",
    "@tailwindcss/postcss": "^4.0.17",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.13.14",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.2.4",
    "prisma": "^6.5.0",
    "tailwindcss": "^4.0.17",
    "typescript": "^5.8.2"
  }
}
