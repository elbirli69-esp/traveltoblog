# syntax=docker/dockerfile:1
# Imagen con WeasyPrint para export PDF.
# En Synology el build Docker suele no tener DNS: se instalan debs offline (scripts/bundle-weasyprint-debs.sh).
FROM node:22-bookworm-slim AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
ENV DATABASE_URL=file:/app/data/travel.db
ENV WEASYPRINT_BIN=/usr/bin/weasyprint

COPY docker/debian-debs /tmp/debian-debs

RUN if [ -f /tmp/debian-debs/Packages.gz ]; then \
      echo "Installing WeasyPrint from offline apt repo…"; \
      echo "deb [trusted=yes] file:/tmp/debian-debs ./" > /etc/apt/sources.list.d/offline-weasyprint.list; \
      apt-get update \
      && apt-get install -y --no-install-recommends weasyprint python3 \
      && rm -f /etc/apt/sources.list.d/offline-weasyprint.list; \
    elif ls /tmp/debian-debs/*.deb >/dev/null 2>&1; then \
      echo "Installing WeasyPrint from offline debs (dpkg)…"; \
      dpkg -i /tmp/debian-debs/*.deb 2>/dev/null || true; \
      apt-get -f install -y --no-install-recommends \
        -o Dir::Cache::archives=/tmp/debian-debs \
        -o Dir::Cache::archives/partial=/tmp/debian-debs/partial \
        -o APT::Get::Download=false; \
    else \
      echo "No offline debs — installing WeasyPrint from apt (needs network)…"; \
      apt-get update \
      && apt-get install -y --no-install-recommends weasyprint python3; \
    fi \
  && rm -rf /var/lib/apt/lists/* /tmp/debian-debs \
  && addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 --ingroup nodejs nextjs \
  && mkdir -p /app/data /app/public/uploads \
  && chown -R nextjs:nodejs /app/data /app/public/uploads

COPY --chown=nextjs:nodejs .next/standalone ./
COPY --chown=nextjs:nodejs .next/static ./.next/static
COPY --chown=nextjs:nodejs public ./public
RUN rm -f ./public/manifest.webmanifest
COPY --chown=nextjs:nodejs prisma ./prisma
COPY --chown=nextjs:nodejs node_modules/.prisma ./node_modules/.prisma
COPY --chown=nextjs:nodejs node_modules/@prisma ./node_modules/@prisma
COPY --chown=nextjs:nodejs package.json ./package.json
COPY --chown=nextjs:nodejs scripts ./scripts

USER nextjs
EXPOSE 3000

CMD ["node", "server.js"]
